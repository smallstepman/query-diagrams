direction: right

backend: Backend {
  style.fill: "#f8fafc"

  api: API {
    shape: rectangle
    dq.tier: backend
    style.fill: "#eef2ff"
  }

  db: Database {
    shape: cylinder
    dq.tier: backend
  }

  api -> db: query
}

client: Client {
  shape: rectangle
  dq.tier: frontend
}

client -> backend.api: request
